{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PHANTOM",
  "version": "2.1.0",
  "identifier": "ua.phantom.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PHANTOM",
        "width": 980,
        "height": 720,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/phantom-bridge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "public.app-category.utilities",
    "shortDescription": "Hide an encrypted file inside a picture",
    "longDescription": "PHANTOM hides an AES-256-GCM encrypted payload (a PDF, any file, or text) inside a PNG image or a WAV/FLAC audio file. Payload positions are derived from the password (v5 layout, syndrome trellis). Built for people who must move data, not for people who like magic.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "windows": {}
  }
}
